BLANKET_DATABASE_URL=postgresql://blanket:blanket@localhost:5432/blanket

BLANKET_HOST=0.0.0.0
BLANKET_PORT=8000
BLANKET_TRANSPORT=streamable-http   # streamable-http | stdio | sse
BLANKET_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# Authentication
# Set to false for local dev (skips API key validation)
BLANKET_REQUIRE_AUTH=false # for dev mode only

# Database pool
BLANKET_DB_POOL_MIN=2
BLANKET_DB_POOL_MAX=10
BLANKET_DB_COMMAND_TIMEOUT=30

# Max policies per injection (safety cap)
BLANKET_MAX_POLICIES=20
